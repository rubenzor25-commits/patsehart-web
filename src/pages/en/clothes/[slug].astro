---
import type { GetStaticPaths } from 'astro';
import View from '../../../views/Prenda.astro';
import { prendas } from '../../../data/works';

export const getStaticPaths = (() => prendas.map((item) => ({ params: { slug: item.slug }, props: { item } }))) satisfies GetStaticPaths;
const { item } = Astro.props;
---

<View lang="en" prenda={item} />
