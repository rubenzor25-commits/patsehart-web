---
import type { ImageMetadata } from 'astro';
import Gallery from './Gallery.astro';
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n/ui';

interface Link {
  href: string;
  label: string;
}
interface Props {
  lang: Lang;
  section: string;
  crumbs: Link[];
  images: ImageMetadata[];
  title: string;
  subtitle?: string;
  lines: string[];
  badge?: string;
  prev?: Link;
  next?: Link;
}
const { lang, section, crumbs, images, title, subtitle, lines, badge, prev, next } = Astro.props;
const t = ui[lang];
---

<div class="container">
  <p class="section-title" aria-hidden="true">{section}</p>

  <div class="detail__bar">
    <nav class="crumbs" aria-label="Breadcrumb">
      {
        crumbs.map((c) => (
          <>
            <a href={c.href}>{c.label}</a>
            <span aria-hidden="true">/</span>
          </>
        ))
      }
      <span aria-current="page">{title}</span>
    </nav>
    {
      (prev || next) && (
        <nav class="pager" aria-label={`${t.prev} / ${t.next}`}>
          {prev && (
            <a href={prev.href} rel="prev" title={prev.label}>
              <Icon name="arrow-left" size={14} /> {t.prev}
            </a>
          )}
          {prev && next && <span aria-hidden="true">|</span>}
          {next && (
            <a href={next.href} rel="next" title={next.label}>
              {t.next} <Icon name="arrow-right" size={14} />
            </a>
          )}
        </nav>
      )
    }
  </div>

  <article class="detail">
    <div class="detail__media">
      <Gallery lang={lang} images={images} title={title} />
    </div>
    <div class="detail__info">
      {badge && <p class="detail__badge">{badge}</p>}
      <h1 class="detail__title">{title}</h1>
      {subtitle && <p class="detail__subtitle">{subtitle}</p>}
      {lines.map((l) => <p class="detail__line">{l}</p>)}
      <div class="detail__actions">
        <slot name="actions" />
      </div>
      <slot name="note" />
    </div>
  </article>

  <slot />
</div>

<style>
  .detail__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin: -12px 0 28px;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .crumbs a:hover,
  .pager a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pager {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pager a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .detail {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .detail {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(40px, 6vw, 96px);
    }
  }
  .detail__info {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .detail__badge {
    margin: 0 0 10px;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .detail__title {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 30px);
    letter-spacing: 0.3em;
    padding-left: 0.3em;
    text-transform: uppercase;
    line-height: 1.4;
  }
  .detail__subtitle {
    margin: -8px 0 16px;
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .detail__line {
    margin: 0 0 12px;
    font-size: 16px;
  }
  .detail__actions {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
</style>
