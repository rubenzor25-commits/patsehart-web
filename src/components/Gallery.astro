---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  images: ImageMetadata[];
  title: string;
}
const { lang, images, title } = Astro.props;
const t = ui[lang];
const full = await Promise.all(images.map((src) => getImage({ src, width: 2000, format: 'webp' })));
---

<div class="gallery" data-gallery>
  <div class="gallery__stage">
    {
      images.map((src, i) => (
        <button
          type="button"
          class="gallery__slide"
          data-full={full[i].src}
          aria-label={`${t.zoom}: ${title}`}
          hidden={i > 0}
        >
          <Picture
            src={src}
            alt={images.length > 1 ? `${title} (${i + 1}/${images.length})` : title}
            formats={['webp']}
      fallbackFormat="webp"
            widths={[480, 720, 1000, 1400]}
            sizes="(min-width: 900px) 46vw, 92vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </button>
      ))
    }
  </div>
  {
    images.length > 1 && (
      <div class="gallery__thumbs">
        {images.map((src, i) => (
          <button type="button" class="gallery__thumb" aria-current={i === 0 ? 'true' : 'false'} data-index={i}>
            <Picture src={src} alt="" formats={['webp']}
      fallbackFormat="webp" widths={[160]} sizes="80px" />
          </button>
        ))}
      </div>
    )
  }
  <dialog class="lightbox">
    <button type="button" class="lightbox__close" aria-label={t.nav.close}>
      <Icon name="close" size={28} />
    </button>
    <img class="lightbox__img" alt={title} />
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const slides = [...g.querySelectorAll<HTMLButtonElement>('.gallery__slide')];
    const thumbs = [...g.querySelectorAll<HTMLButtonElement>('.gallery__thumb')];
    const dialog = g.querySelector<HTMLDialogElement>('.lightbox')!;
    const big = g.querySelector<HTMLImageElement>('.lightbox__img')!;

    thumbs.forEach((th) =>
      th.addEventListener('click', () => {
        const i = Number(th.dataset.index);
        slides.forEach((s, k) => (s.hidden = k !== i));
        thumbs.forEach((x, k) => x.setAttribute('aria-current', String(k === i)));
      }),
    );
    slides.forEach((s) =>
      s.addEventListener('click', () => {
        big.src = s.dataset.full!;
        dialog.showModal();
      }),
    );
    g.querySelector('.lightbox__close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .gallery {
    display: grid;
    gap: 14px;
  }
  .gallery__slide {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .gallery__slide[hidden] {
    display: none;
  }
  .gallery__slide :global(img) {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
  }
  .gallery__thumbs {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .gallery__thumb {
    width: 64px;
    height: 64px;
    padding: 0;
    border: 1px solid transparent;
    background: none;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }
  .gallery__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery__thumb[aria-current='true'] {
    opacity: 1;
    border-color: var(--ink);
  }
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(255, 255, 255, 0.97);
  }
  .lightbox::backdrop {
    background: rgba(255, 255, 255, 0.9);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox__img {
    max-width: 94vw;
    max-height: 92dvh;
    object-fit: contain;
  }
  .lightbox__close {
    position: absolute;
    top: 16px;
    right: 16px;
    border: 0;
    background: none;
    padding: 8px;
    cursor: pointer;
  }
</style>
