---
interface Props {
  name: 'mail' | 'instagram' | 'pinterest' | 'menu' | 'close' | 'arrow-left' | 'arrow-right';
  size?: number;
}
const { name, size = 16 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="1.5" />
        <path d="m3.5 6 8.5 7 8.5-7" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
      </>
    )
  }
  {
    name === 'pinterest' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M11 9.5c.4-1.4 3.6-1.6 4 .6.4 2-1 4-2.6 4-1.1 0-1.6-.8-1.4-1.6M11.6 11.4 9.8 19" />
      </>
    )
  }
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'arrow-left' && <path d="M15 5l-7 7 7 7" />}
  {name === 'arrow-right' && <path d="M9 5l7 7-7 7" />}
</svg>
