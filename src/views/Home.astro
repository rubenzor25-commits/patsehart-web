---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { obras } from '../data/obras';
import { href, ui, type Lang } from '../i18n/ui';
import { img } from '../lib/images';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const nuevas = obras.filter((o) => o.nueva);
---

<Base
  lang={lang}
  route="home"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    jobTitle: lang === 'es' ? 'Artista' : 'Artist',
    url: new URL(href(lang, 'home'), Astro.site).href,
    sameAs: [site.instagram],
  }}
>
  <h1 class="visually-hidden">{site.studio} — {t.tagline}</h1>

  <section class="hero">
    <p class="section-title hero__title">{t.nuevaColeccion}</p>
    <div class="hero__frame">
      <Picture
        src={img('site/hero.jpg')}
        alt={`${site.name} — ${t.nuevaColeccion}`}
        formats={['webp']}
      fallbackFormat="webp"
        widths={[480, 720, 843]}
        sizes="(min-width: 900px) 760px, 92vw"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <a class="btn btn--light hero__cta" href={href(lang, 'obras')}>{t.obrasOriginales}</a>
    </div>
  </section>

  <section class="container blocks" aria-label={`${t.obrasOriginales} · ${t.dress}`}>
    <div class="grid grid--two">
      <Card href={href(lang, 'obras')} image={img('site/home-obras.jpg')} title={t.obrasOriginales} sizes="(min-width: 960px) 420px, 46vw" />
      <Card href={href(lang, 'clothes')} image={img('site/home-dress.jpg')} title={t.dress} sizes="(min-width: 960px) 420px, 46vw" />
    </div>
  </section>

  <section class="container">
    <h2 class="section-title">{t.nuevaColeccion}</h2>
    <div class="grid">
      {nuevas.map((o) => <Card href={href(lang, 'obra', o.slug)} image={img(o.images[0])} title={o.title} />)}
    </div>
    <p class="more">
      <a class="btn" href={href(lang, 'obras')}>{t.viewAll}</a>
    </p>
  </section>
</Base>

<style>
  .hero {
    background: #000;
    color: #fff;
    padding: 4px var(--gutter) clamp(28px, 5vw, 56px);
    margin-bottom: clamp(48px, 8vw, 96px);
  }
  .hero__title {
    margin: clamp(14px, 2vw, 22px) 0 clamp(18px, 3vw, 28px);
  }
  .hero__frame {
    position: relative;
    max-width: 760px;
    margin-inline: auto;
  }
  .hero__frame :global(.hero__img) {
    width: 100%;
    height: auto;
  }
  .hero__cta {
    position: absolute;
    left: 50%;
    bottom: clamp(18px, 6%, 48px);
    transform: translateX(-50%);
    white-space: nowrap;
    background: rgba(0, 0, 0, 0.15);
  }
  .blocks {
    margin-bottom: clamp(32px, 6vw, 72px);
  }
  .more {
    margin: clamp(40px, 6vw, 64px) 0 0;
    text-align: center;
  }
</style>
