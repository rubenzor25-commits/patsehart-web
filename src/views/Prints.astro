---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import RequestButton from '../components/RequestButton.astro';
import { obras } from '../data/obras';
import { href, ui, type Lang } from '../i18n/ui';
import { img } from '../lib/images';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const muestra = ['magma', 'electric-bloom', 'wine'].map((s) => obras.find((o) => o.slug === s)!);
---

<Base lang={lang} route="prints" title={t.printsTitle}>
  <div class="container">
    <h1 class="section-title">{t.printsTitle}</h1>
    <div class="prints">
      <p>{t.printsText}</p>
      <RequestButton lang={lang} work={t.printsTitle} label={t.printsCta} prefill={t.form.printPrefill} />
    </div>
    <div class="grid">
      {muestra.map((o) => <Card href={href(lang, 'obra', o.slug)} image={img(o.images[0])} title={o.title} />)}
    </div>
  </div>
</Base>

<style>
  .prints {
    max-width: 620px;
    margin: 0 auto clamp(48px, 8vw, 88px);
    text-align: center;
    display: grid;
    gap: 20px;
    justify-items: center;
  }
  .prints p {
    margin: 0;
  }
</style>
